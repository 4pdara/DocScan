    <string name="hint_marks">הסרה ניסיונית של סימונים צבעוניים. היא עלולה להסיר גם תוכן צבעוני; המקור נשמר.</string>
    <string name="hint_restore">שיפור מקומי של ניגודיות וחדות. אין יצירת פרטים חדשים או שחזור פנים באמצעות AI.</string>
    <string name="hint_ai">כלי ענן אופציונלי. הגדירו שירות תואם Chat Completions; שליחה מתבצעת רק בלחיצה מפורשת, ועשויה להיות בתשלום לספק.</string>
    <string name="hint_count">ספירה ניסיונית של עצמים נפרדים ברקע אחיד. בדקו סמנים; נגיעה מוסיפה או מסירה סמן.</string>
    <string name="hint_lock">ייצוא עותק PDF מוגן בסיסמה. הסריקות המקומיות אינן ננעלות. אין דרך לשחזר סיסמה שנשכחה.</string>
